<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Windedit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Windedit"
    Title="Windedit">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- A photo in the filmstrip and grid: thumbnail, then stars, flag and label below. -->
            <DataTemplate x:Key="PhotoTemplate" x:DataType="local:PhotoItem">
                <Border BorderThickness="2" BorderBrush="{x:Bind CurrentBrush, Mode=OneWay}" CornerRadius="4"
                        Padding="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Tapped="Thumbnail_Tapped" DoubleTapped="Thumbnail_DoubleTapped">
                    <Grid RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="16" />
                        </Grid.RowDefinitions>
                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Opacity="{x:Bind Dimming, Mode=OneWay}" Stretch="Uniform" />
                        <Grid Grid.Row="1" ColumnSpacing="4" Opacity="{x:Bind Dimming, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" Fill="{x:Bind LabelBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Stars, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <FontIcon Grid.Column="3" Glyph="{x:Bind EditedGlyph, Mode=OneWay}" FontSize="11" Opacity="0.8" />
                            <FontIcon Grid.Column="4" Glyph="{x:Bind FlagGlyph, Mode=OneWay}" FontSize="11" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Padding="10,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SplitButton x:Name="OpenButton" Click="OpenFolder_Click" ToolTipService.ToolTip="Open a folder (Ctrl+O)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                    <TextBlock Text="Open folder" />
                </StackPanel>
                <SplitButton.Flyout>
                    <MenuFlyout x:Name="RecentMenu" Placement="BottomEdgeAlignedLeft" />
                </SplitButton.Flyout>
            </SplitButton>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0">
                <ToggleButton x:Name="LoupeToggle" Click="Loupe_Click" ToolTipService.ToolTip="Loupe (E)">
                    <FontIcon Glyph="&#xE8B9;" FontSize="14" />
                </ToggleButton>
                <ToggleButton x:Name="GridToggle" Click="Grid_Click" ToolTipService.ToolTip="Grid (G)">
                    <FontIcon Glyph="&#xF0E2;" FontSize="14" />
                </ToggleButton>
                <ToggleButton x:Name="EditToggle" Click="Edit_Click" Margin="8,0,0,0" ToolTipService.ToolTip="Edit: the developed raw (D)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <!-- Filters -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Show" VerticalAlignment="Center" Opacity="0.7" />
                <ComboBox x:Name="FlagFilter" SelectionChanged="Filter_Changed" MinWidth="130">
                    <ComboBoxItem Content="All photos" />
                    <ComboBoxItem Content="Not rejected" />
                    <ComboBoxItem Content="Picks" />
                    <ComboBoxItem Content="Rejects" />
                </ComboBox>
                <ComboBox x:Name="RatingFilter" SelectionChanged="Filter_Changed" MinWidth="110">
                    <ComboBoxItem Content="Any rating" />
                    <ComboBoxItem Content="★ or more" />
                    <ComboBoxItem Content="★★ or more" />
                    <ComboBoxItem Content="★★★ or more" />
                    <ComboBoxItem Content="★★★★ or more" />
                    <ComboBoxItem Content="★★★★★" />
                </ComboBox>
                <ComboBox x:Name="LabelFilter" SelectionChanged="Filter_Changed" MinWidth="110">
                    <ComboBoxItem Content="Any label" />
                    <ComboBoxItem Content="Red" />
                    <ComboBoxItem Content="Yellow" />
                    <ComboBoxItem Content="Green" />
                    <ComboBoxItem Content="Blue" />
                    <ComboBoxItem Content="Purple" />
                </ComboBox>
            </StackPanel>

            <TextBlock x:Name="CountText" Grid.Column="4" VerticalAlignment="Center" Opacity="0.7" />
        </Grid>

        <!-- The photo (with the Edit panel beside it in Edit mode), or the grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SwapChainPanel x:Name="Panel"
                            SizeChanged="Panel_SizeChanged"
                            CompositionScaleChanged="Panel_CompositionScaleChanged"
                            PointerPressed="Panel_PointerPressed" />
            <ScrollViewer x:Name="EditPanel" Grid.Column="1" Width="300" Visibility="Collapsed"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <StackPanel x:Name="EditControls" Padding="16,10,16,16" Spacing="2" />
            </ScrollViewer>
        </Grid>
        <ScrollViewer x:Name="GridScroller" Grid.Row="1" Visibility="Collapsed" Padding="10"
                      ViewChanged="Scroller_ViewChanged">
            <ItemsRepeater x:Name="GridRepeater" ItemTemplate="{StaticResource PhotoTemplate}"
                           ElementPrepared="Repeater_ElementPrepared" ElementClearing="Repeater_ElementClearing">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="190" MinItemHeight="150" MinRowSpacing="6" MinColumnSpacing="6"
                                       ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />

        <!-- Filmstrip (loupe only) -->
        <ScrollViewer x:Name="FilmstripScroller" Grid.Row="2" Height="118" Padding="10,4"
                      HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                      ViewChanged="Scroller_ViewChanged">
            <ItemsRepeater x:Name="Filmstrip" ItemTemplate="{StaticResource PhotoTemplate}"
                           ElementPrepared="Repeater_ElementPrepared" ElementClearing="Repeater_ElementClearing">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="6" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Status -->
        <Grid Grid.Row="3" Padding="12,4,12,6" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PhotoText" FontWeight="SemiBold" />
            <TextBlock x:Name="KeysText" Grid.Column="1" Opacity="0.55" TextTrimming="CharacterEllipsis"
                       Text="← → move · 0–5 stars · P pick · X reject · U clear · 6–9 labels · Shift or Caps Lock: rate and move on · Z 100% · G grid · E loupe · D edit" />
            <TextBlock x:Name="TimingText" Grid.Column="2" Opacity="0.55" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
