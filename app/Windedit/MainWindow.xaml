<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Windedit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Windedit"
    Title="Windedit">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- A photo in the filmstrip and grid: thumbnail, then stars, flag and label below. -->
            <DataTemplate x:Key="PhotoTemplate" x:DataType="local:PhotoItem">
                <Border BorderThickness="2" BorderBrush="{x:Bind CurrentBrush, Mode=OneWay}" CornerRadius="4"
                        Padding="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Tapped="Thumbnail_Tapped" DoubleTapped="Thumbnail_DoubleTapped">
                    <Grid RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="16" />
                        </Grid.RowDefinitions>
                        <!-- The Image sizes itself to its picture, so the badge sits on the picture's corner, not the cell's. -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Opacity="{x:Bind Dimming, Mode=OneWay}" Stretch="Uniform" />
                            <Border Visibility="{x:Bind EditedVisibility, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,5,5" Width="20" Height="20" CornerRadius="10" Background="#B3000000"
                                    ToolTipService.ToolTip="Edited">
                                <FontIcon Glyph="&#xE9E9;" FontSize="11" Foreground="White" />
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="4" Opacity="{x:Bind Dimming, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" Fill="{x:Bind LabelBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Stars, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <FontIcon Grid.Column="3" Glyph="{x:Bind FlagGlyph, Mode=OneWay}" FontSize="11" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- A folder in the Folders panel (the trees are in ItemsSource mode, so the template gets the folder). -->
            <DataTemplate x:Key="FolderTemplate" x:DataType="local:FolderEntry">
                <TreeViewItem ItemsSource="{x:Bind Children}" HasUnrealizedChildren="{x:Bind HasUnrealized}"
                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind Tip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Opacity="0.8" />
                        <TextBlock Text="{x:Bind Name}" FontWeight="{x:Bind Weight}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </TreeViewItem>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar. The Folders and Edit toggles are icon-only and pinned to the two ends, like
             Windshot's Layers button; their labels live in the tooltips. -->
        <Grid Padding="4,0" ColumnSpacing="8">
            <Grid.Resources>
                <Style TargetType="AppBarButton" BasedOn="{StaticResource DefaultAppBarButtonStyle}">
                    <Setter Property="Width" Value="36" />
                </Style>
                <Style TargetType="AppBarToggleButton" BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}">
                    <Setter Property="Width" Value="36" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CommandBar Background="Transparent" DefaultLabelPosition="Collapsed" OverflowButtonVisibility="Collapsed">
                <AppBarToggleButton x:Name="FoldersToggle" Label="Folders" Click="Folders_Click" ToolTipService.ToolTip="Folders (F7)">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
            </CommandBar>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <ToggleButton x:Name="LoupeToggle" Click="Loupe_Click" ToolTipService.ToolTip="Loupe (E)">
                    <FontIcon Glyph="&#xE8B9;" FontSize="14" />
                </ToggleButton>
                <ToggleButton x:Name="GridToggle" Click="Grid_Click" ToolTipService.ToolTip="Grid (G)">
                    <FontIcon Glyph="&#xF0E2;" FontSize="14" />
                </ToggleButton>
            </StackPanel>

            <!-- Filters -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Show" VerticalAlignment="Center" Opacity="0.7" />
                <ComboBox x:Name="FlagFilter" SelectionChanged="Filter_Changed" MinWidth="130">
                    <ComboBoxItem Content="All photos" />
                    <ComboBoxItem Content="Not rejected" />
                    <ComboBoxItem Content="Picks" />
                    <ComboBoxItem Content="Rejects" />
                </ComboBox>
                <ComboBox x:Name="RatingFilter" SelectionChanged="Filter_Changed" MinWidth="110">
                    <ComboBoxItem Content="Any rating" />
                    <ComboBoxItem Content="★ or more" />
                    <ComboBoxItem Content="★★ or more" />
                    <ComboBoxItem Content="★★★ or more" />
                    <ComboBoxItem Content="★★★★ or more" />
                    <ComboBoxItem Content="★★★★★" />
                </ComboBox>
                <ComboBox x:Name="LabelFilter" SelectionChanged="Filter_Changed" MinWidth="110">
                    <ComboBoxItem Content="Any label" />
                    <ComboBoxItem Content="Red" />
                    <ComboBoxItem Content="Yellow" />
                    <ComboBoxItem Content="Green" />
                    <ComboBoxItem Content="Blue" />
                    <ComboBoxItem Content="Purple" />
                </ComboBox>
            </StackPanel>

            <TextBlock x:Name="CountText" Grid.Column="4" VerticalAlignment="Center" Opacity="0.7" />
            <CommandBar Grid.Column="5" Background="Transparent" DefaultLabelPosition="Collapsed" OverflowButtonVisibility="Collapsed">
                <AppBarButton x:Name="AppearanceButton" Label="Appearance" ToolTipService.ToolTip="Appearance: light or dark, and theme">
                    <AppBarButton.Icon>
                        <FontIcon x:Name="AppearanceIcon" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <Flyout x:Name="AppearanceFlyout" Placement="BottomEdgeAlignedRight">
                            <StackPanel x:Name="AppearanceContent" Width="330" Spacing="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Mode" Opacity="0.7" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <RadioButton x:Name="ModeAuto" GroupName="Mode" MinWidth="0" Content="Auto" Tag="Default" Checked="Mode_Checked" />
                                        <RadioButton x:Name="ModeLight" GroupName="Mode" MinWidth="0" Content="Light" Tag="Light" Checked="Mode_Checked" />
                                        <RadioButton x:Name="ModeDark" GroupName="Mode" MinWidth="0" Content="Dark" Tag="Dark" Checked="Mode_Checked" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Theme" Opacity="0.7" />
                                    <ListView x:Name="ThemeList" SelectionMode="Single" SelectionChanged="Theme_SelectionChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="ExportButton" Label="Export" ToolTipService.ToolTip="Export JPEG (Ctrl+Shift+E)">
                    <AppBarButton.Icon>
                        <FontIcon x:Name="ExportIcon" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <Flyout x:Name="ExportFlyout" Placement="BottomEdgeAlignedRight"
                                Opening="ExportFlyout_Opening" Closed="ExportFlyout_Closed">
                            <StackPanel x:Name="ExportContent" Width="330" Spacing="10">
                                <TextBlock x:Name="ExportTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Destination" Opacity="0.7" />
                                    <RadioButton x:Name="ExportNextTo" GroupName="ExportWhere" Content="Export folder next to the photos"
                                                 Click="ExportWhere_Click" />
                                    <TextBlock x:Name="ExportNextToPath" Margin="30,0,0,6" Opacity="0.55" FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                    <RadioButton x:Name="ExportChoose" GroupName="ExportWhere" Content="Choose folder…"
                                                 Click="ExportWhere_Click" />
                                    <TextBlock x:Name="ExportChosenPath" Margin="30,0,0,0" Opacity="0.55" FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" MinWidth="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Quality" VerticalAlignment="Center" Opacity="0.7" />
                                    <Slider x:Name="ExportQuality" Grid.Column="1" Minimum="50" Maximum="100" StepFrequency="1"
                                            ValueChanged="ExportQuality_ValueChanged" />
                                    <TextBlock x:Name="ExportQualityText" Grid.Column="2" VerticalAlignment="Center" HorizontalTextAlignment="End" />
                                </Grid>
                                <TextBlock Text="Full size, sRGB, with the camera's EXIF." Opacity="0.55" FontSize="12" />
                                <Button x:Name="ExportGo" Content="Export" Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch" Click="ExportGo_Click" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarToggleButton x:Name="EditToggle" Label="Edit" Click="Edit_Click" ToolTipService.ToolTip="Edit: the developed raw (D, F8)">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
            </CommandBar>
        </Grid>

        <!-- Folders on the left, the photo or the grid in the middle, the Edit panel on the right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="FoldersPanel" Width="260" RowSpacing="6"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <!-- A camera card, while one is in (MainWindow.Import.cs): its photos open like a folder; Import copies the new ones. -->
                <Border x:Name="ImportEntry" Margin="8,8,8,0" Padding="10,8,8,10" CornerRadius="6" Visibility="Collapsed"
                        Background="{ThemeResource LayerFillColorDefaultBrush}" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <Grid x:Name="ImportHeader" ColumnSpacing="8" Background="Transparent" Tapped="ImportHeader_Tapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE896;" FontSize="16" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ImportTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ImportCounts" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button x:Name="ImportSettings" Grid.Column="2" Padding="6" Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Import settings">
                                <FontIcon Glyph="&#xE713;" FontSize="14" />
                                <Button.Flyout>
                                    <Flyout x:Name="ImportFlyout" Placement="BottomEdgeAlignedLeft" Opening="ImportFlyout_Opening" Closed="ImportFlyout_Closed">
                                        <StackPanel Width="320" Spacing="10">
                                            <TextBlock Text="Import settings" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Copy photos to" Opacity="0.7" />
                                                <TextBlock Text="Each goes to a folder named for the day it was taken, inside one for the year." FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="ImportDestPath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1" Content="Change…" Click="ImportDest_Click" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <CheckBox x:Name="ImportBackupOn" Content="Also copy to a backup" Click="ImportBackupOn_Click" />
                                                <Grid ColumnSpacing="8" Margin="28,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="ImportBackupPath" VerticalAlignment="Center" Opacity="0.55" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1" Content="Change…" Click="ImportBackup_Click" />
                                                </Grid>
                                            </StackPanel>
                                            <CheckBox x:Name="ImportVerify" Content="Check each copy against the card (slower)" Click="ImportVerify_Click" />
                                            <CheckBox x:Name="ImportEject" Content="Eject the card when done" Click="ImportEject_Click" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <Button x:Name="ImportGo" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="ImportGo_Click" />
                        <StackPanel x:Name="ImportProgressBox" Spacing="4" Visibility="Collapsed">
                            <ProgressBar x:Name="ImportBar" Maximum="1" />
                            <TextBlock x:Name="ImportProgressText" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                            <Button x:Name="ImportCancel" Content="Stop" HorizontalAlignment="Right" Click="ImportCancel_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ImportMessage" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <TextBox x:Name="FolderSearch" Grid.Row="1" Margin="8,0,8,0" PlaceholderText="Search folders"
                         TextChanged="FolderSearch_TextChanged" />
                <TreeView x:Name="FolderTree" Grid.Row="2" SelectionMode="Single" ItemTemplate="{StaticResource FolderTemplate}"
                          Expanding="FolderTree_Expanding" ItemInvoked="FolderTree_ItemInvoked" />
                <TreeView x:Name="SearchTree" Grid.Row="2" SelectionMode="Single" ItemTemplate="{StaticResource FolderTemplate}"
                          Visibility="Collapsed" ItemInvoked="FolderTree_ItemInvoked" />
                <TextBlock x:Name="SearchStatus" Grid.Row="2" Margin="12,8" Opacity="0.6" TextWrapping="Wrap"
                           VerticalAlignment="Top" IsHitTestVisible="False" />
            </Grid>

            <!-- A CursorGrid so the hand cursor of panning a zoomed photo can be set over the swap chain panel. -->
            <local:CursorGrid x:Name="CanvasHost" Grid.Column="1">
                <SwapChainPanel x:Name="Panel"
                                SizeChanged="Panel_SizeChanged"
                                CompositionScaleChanged="Panel_CompositionScaleChanged"
                                PointerPressed="Panel_PointerPressed" PointerMoved="Panel_PointerMoved"
                                PointerReleased="Panel_PointerReleased" PointerCaptureLost="Panel_PointerCaptureLost" />
                <!-- Crop mode's overlay (MainWindow.Crop.cs): follows the panel's size, so it follows the window and the side panels. -->
                <local:CursorCanvas x:Name="CropCanvas" Visibility="Collapsed" Background="Transparent" />
                <!-- The Masks panel's handles on the photo (MainWindow.Masks.cs). -->
                <local:CursorCanvas x:Name="MaskCanvas" Visibility="Collapsed" Background="Transparent" />
                <!-- The brush's tool strip (MainWindow.Masks.cs): a floating card over the top of the photo, above the mask canvas so nothing on it paints. -->
                <Border x:Name="BrushStrip" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8,10,8,0"
                        Padding="14,6,14,4" CornerRadius="8" BorderThickness="1" Translation="0,0,24"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                </Border>
                <!-- The white balance picker's layer (MainWindow.Picker.cs): takes the click, shows a crosshair. -->
                <local:CursorGrid x:Name="PickLayer" Visibility="Collapsed" Background="Transparent"
                                  PointerPressed="PickLayer_PointerPressed" />
                <ScrollViewer x:Name="GridScroller" Visibility="Collapsed" Padding="10"
                              ViewChanged="Scroller_ViewChanged" SizeChanged="Scroller_SizeChanged">
                    <ItemsRepeater x:Name="GridRepeater" ItemTemplate="{StaticResource PhotoTemplate}"
                                   ElementPrepared="Repeater_ElementPrepared" ElementClearing="Repeater_ElementClearing">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="190" MinItemHeight="150" MinRowSpacing="6" MinColumnSpacing="6"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
            </local:CursorGrid>

            <!-- The Edit panel: a tool strip that stays put (MainWindow.Tools.cs), and under it whichever tool's panel is showing. -->
            <Grid x:Name="EditPanel" Grid.Column="2" Width="300" Visibility="Collapsed"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                        <StackPanel.Resources>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                                <Setter Property="Width" Value="44" />
                                <Setter Property="Height" Value="36" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </StackPanel.Resources>
                        <ToggleButton x:Name="EditTool" Click="EditTool_Click" ToolTipService.ToolTip="Edit: the adjustments"
                                      AutomationProperties.Name="Edit">
                            <FontIcon Glyph="&#xE9E9;" FontSize="18" />
                        </ToggleButton>
                        <ToggleButton x:Name="CropTool" Click="CropTool_Click" ToolTipService.ToolTip="Crop and straighten (R)"
                                      AutomationProperties.Name="Crop">
                            <FontIcon Glyph="&#xE7A8;" FontSize="18" />
                        </ToggleButton>
                        <ToggleButton x:Name="MaskTool" Click="MaskTool_Click" ToolTipService.ToolTip="Masks: local adjustments (Shift+W)"
                                      AutomationProperties.Name="Masks">
                            <FontIcon Glyph="&#xEA3A;" FontSize="18" />
                        </ToggleButton>
                    </StackPanel>
                </Border>
                <ScrollViewer x:Name="EditScroller" Grid.Row="1">
                    <StackPanel>
                        <!-- Crop has its handles on the photo; this says what they do. -->
                        <TextBlock x:Name="CropHelp" Visibility="Collapsed" Margin="20,12,16,0" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="Drag corners or edges to resize · drag inside to move · drag outside to rotate&#10;Enter: done · Esc: cancel" />
                        <!-- The Crop group, shown instead of the Edit groups while the Crop tool is on. -->
                        <StackPanel x:Name="CropControls" Padding="16,10,16,16" Spacing="2" Visibility="Collapsed" />
                        <StackPanel x:Name="EditControls" Padding="16,10,16,16" Spacing="2" />
                        <!-- The Masks panel (MainWindow.Masks.cs) takes the place of the Edit groups while it is open. -->
                        <StackPanel x:Name="MaskControls" Padding="16,10,16,16" Spacing="2" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Filmstrip (loupe only) -->
        <ScrollViewer x:Name="FilmstripScroller" Grid.Row="2" Height="118" Padding="10,4"
                      HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                      ViewChanged="Scroller_ViewChanged" SizeChanged="Scroller_SizeChanged">
            <ItemsRepeater x:Name="Filmstrip" ItemTemplate="{StaticResource PhotoTemplate}"
                           ElementPrepared="Repeater_ElementPrepared" ElementClearing="Repeater_ElementClearing">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="6" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Status -->
        <Grid Grid.Row="3" Padding="12,4,12,6" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PhotoText" FontWeight="SemiBold" />
            <TextBlock x:Name="PickStatus" Grid.Column="1" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="KeysText" Grid.Column="1" Opacity="0.55" TextTrimming="CharacterEllipsis"
                       Text="← → move · 0–5 stars · P pick · X reject · U clear · 6–9 labels · Shift or Caps Lock: rate and move on · R crop · W white balance · Shift+W masks (M, Shift+M, O) · Z 100% · G grid · E loupe · D edit · F7 folders · F8 edit panel · Tab both · Ctrl+Shift+E export" />
            <StackPanel x:Name="ExportStatus" Grid.Column="1" Orientation="Horizontal" Spacing="10" Visibility="Collapsed"
                        VerticalAlignment="Center">
                <ProgressBar x:Name="ExportProgress" Width="120" Maximum="1" VerticalAlignment="Center" />
                <TextBlock x:Name="ExportText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <HyperlinkButton x:Name="ExportOpen" Content="Open folder" Padding="4,0" MinHeight="0" Click="ExportOpen_Click" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="TimingText" Grid.Column="2" Opacity="0.55" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Where focus rests, so the culling keys work: it takes keys but shows and does nothing. -->
        <ContentControl x:Name="KeyFocus" Grid.Row="3" Width="1" Height="1" HorizontalAlignment="Left"
                        VerticalAlignment="Bottom" IsTabStop="True" UseSystemFocusVisuals="False" />
    </Grid>
</Window>
