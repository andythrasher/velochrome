<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Windedit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Windedit – Phase 1a">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" Padding="12,8">
            <Button Content="Open…" Click="Open_Click">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                </Button.KeyboardAccelerators>
            </Button>
            <ToggleButton x:Name="EditToggle" Content="Edit" Click="Edit_Click" ToolTipService.ToolTip="E" />
            <TextBlock Text="Exposure" VerticalAlignment="Center" />
            <!-- Double-click resets it, as in other editors. Applies to the raw (Edit mode). -->
            <Slider x:Name="ExposureSlider" Width="300" VerticalAlignment="Center"
                    Minimum="-5" Maximum="5" StepFrequency="0.01" IsThumbToolTipEnabled="False"
                    ValueChanged="Exposure_ValueChanged" DoubleTapped="Exposure_DoubleTapped" />
            <TextBlock x:Name="ExposureText" Width="48" VerticalAlignment="Center" Text="0.00" />
            <TextBlock VerticalAlignment="Center" Opacity="0.6"
                       Text="← → Home End move · click for 100%, again to fit · E edit" />
        </StackPanel>

        <SwapChainPanel x:Name="Panel" Grid.Row="1"
                        SizeChanged="Panel_SizeChanged"
                        CompositionScaleChanged="Panel_CompositionScaleChanged"
                        PointerPressed="Panel_PointerPressed" />

        <TextBlock x:Name="Status" Grid.Row="2" Margin="12,6" Opacity="0.8"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" />
    </Grid>
</Window>
